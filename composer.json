{
    "name": "kfoobar/laravel-sportmonks-soccer",
    "description": "Laravel package for Sportmonks Soccer API v2.0. Fork of kirill-latish/laravel-sportmonks-soccer",
    "keywords": ["laravel", "sportmonks", "soccer", "live-scores"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Rebing OÜ",
            "homepage": "http://www.rebing.ee",
            "role": "Company"
        },
        {
            "name": "Mikk Mihkel Nurges",
            "email": "mikk.nurges@rebing.ee",
            "role": "Developer"
        },
        {
            "name": "Kirill Latish",
            "email": "kirill@livezone.io",
            "role": "Developer"
        },
        {
            "name": "David Villa",
            "email": "david@kfoobar.se",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^7.3|^8.0",
        "illuminate/support": "^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
        "guzzlehttp/guzzle": "^6.5.8 || ^7.4.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5",
        "orchestra/testbench": "^5.0 || ^6.0 || ^7.0 || ^8.0 || ^9.0"
    },
    "autoload": {
        "psr-4": {
            "Sportmonks\\SoccerAPI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sportmonks\\SoccerAPI\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sportmonks\\SoccerAPI\\SoccerAPIServiceProvider"
            ],
            "aliases": {
                "SoccerAPI": "Sportmonks\\SoccerAPI\\Facades\\SoccerAPI"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}

{
    "name": "kfoobar/laravel-sportmonks-soccer",
    "description": "Laravel wrapper for the Sportmonks Football API v3",
    "keywords": ["laravel", "sportmonks", "soccer", "live-scores"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Rebing OÜ",
            "homepage": "http://www.rebing.ee",
            "role": "Company"
        },
        {
            "name": "Mikk Mihkel Nurges",
            "email": "mikk.nurges@rebing.ee",
            "role": "Developer"
        },
        {
            "name": "Kirill Latish",
            "email": "kirill@livezone.io",
            "role": "Developer"
        },
        {
            "name": "David Villa",
            "email": "david@kfoobar.se",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "guzzlehttp/guzzle": "^7.10 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "orchestra/testbench": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Sportmonks\\SoccerAPI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sportmonks\\SoccerAPI\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sportmonks\\SoccerAPI\\SoccerAPIServiceProvider"
            ],
            "aliases": {
                "SoccerAPI": "Sportmonks\\SoccerAPI\\Facades\\SoccerAPI"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
